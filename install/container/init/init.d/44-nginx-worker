#!/command/with-contenv bash
#
# Nginx worker settings management
#
# Two upstream defects make the worker-related environment variables silently
# ineffective (verified on nfrastack 8.4-alpine_3.24):
#
# 1) NGINX_WORKER_PROCESSES: upstream defines the variable and ships the
#    template /container/data/nginx/templates/server/server-worker.template,
#    but /container/functions/10-nginx never calls render_template for it.
#    The generated server.conf therefore contains no worker_processes
#    directive and nginx always falls back to its compiled-in default of 1.
#
# 2) NGINX_WORKER_RLIMIT_NOFILE: documented but gated behind the paid
#    "Advanced" functionality, so it is silently reset to the default 100000.
#
# This script writes the missing main-context fragment after the upstream
# 10-nginx init has generated the configuration. server.conf includes
# server.conf.d/*.conf at main context, so worker_processes /
# worker_rlimit_nofile are valid there. Upstream never cleans files in this
# directory that it does not manage itself, so the fragment survives restarts.

source /container/base/functions/container/init
prepare_service single
SERVICE_NAME="nginx-worker"

NGINX_CONFIG_PATH="${NGINX_CONFIG_PATH:-/etc/nginx/}"
CONF_DIR="${NGINX_CONFIG_PATH%/}/server.conf.d"

NGINX_WORKER_PROCESSES="${NGINX_WORKER_PROCESSES:-1}"
NGINX_WORKER_RLIMIT_NOFILE="${NGINX_WORKER_RLIMIT_NOFILE:-100000}"

if ! [[ "${NGINX_WORKER_PROCESSES}" =~ ^[0-9]+$ ]] && [ "${NGINX_WORKER_PROCESSES}" != "auto" ]; then
    print_warn "[nginx-worker] Invalid NGINX_WORKER_PROCESSES='${NGINX_WORKER_PROCESSES}', falling back to '1'"
    NGINX_WORKER_PROCESSES=1
fi

mkdir -p "${CONF_DIR}"
cat > "${CONF_DIR}/worker.conf" <<EOF
# Managed by /container/init/init.d/44-nginx-worker (upstream never renders
# server-worker.template; NGINX_WORKER_RLIMIT_NOFILE is Advanced-gated)
worker_processes ${NGINX_WORKER_PROCESSES};
worker_rlimit_nofile ${NGINX_WORKER_RLIMIT_NOFILE};
EOF

print_info "[nginx-worker] Set worker_processes=${NGINX_WORKER_PROCESSES}, worker_rlimit_nofile=${NGINX_WORKER_RLIMIT_NOFILE}"

liftoff
