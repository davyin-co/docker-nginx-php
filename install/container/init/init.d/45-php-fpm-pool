#!/command/with-contenv bash
#
# PHP-FPM default (www) pool management
#
# Two responsibilities:
#
# 1) Re-apply pm.* process-manager settings that the upstream nfrastack image
#    gates behind its paid "Advanced" functionality. PHPFPM_POOL_DEFAULT_* and
#    the legacy PHP_FPM_* alias are silently reset to upstream defaults during
#    init (verified on 8.4-alpine_3.24), so this script edits the generated
#    pool config after the upstream 20-php-fpm init has run.
#
# 2) Recover when the default pool was never generated: upstream only creates
#    pools for names that have PHPFPM_POOL_<NAME>_LISTEN_TYPE set. Older
#    deployments that set PHPFPM_POOL_WWW_* variables without LISTEN_TYPE end
#    up with NO www pool at all — php-fpm starts with zero pools and the nginx
#    php location block keeps unrendered {{placeholders}}. In that case this
#    script generates the full www pool, the nginx upstream block, and renders
#    the location block.
#
# Precedence for pm values: PHPFPM_POOL_WWW_<SETTING> > PHP_FPM_<SETTING> >
# upstream default. (Pool-specific values of an explicitly-defined pool are
# NOT Advanced-gated, so they are always honored natively by upstream.)

source /container/base/functions/container/init
prepare_service single
SERVICE_NAME="php-fpm-pool"

# --- Detect PHP paths (same pattern as 40-drupal) ---
PHP_DIR=$(ls -d /etc/php[0-9]* 2>/dev/null | head -1)
if [ -n "$PHP_DIR" ]; then
    ENVIRONMENT_DIR="${PHP_DIR}/environment"          # Alpine
    POOLS_DIR="${PHP_DIR}/pools.d"
elif [ -d /etc/php ]; then
    PHP_DIR=$(find /etc/php -maxdepth 1 -mindepth 1 -type d | head -1)
    if [ -d "${PHP_DIR}/fpm/environment" ]; then
        ENVIRONMENT_DIR="${PHP_DIR}/fpm/environment"  # Debian
    else
        ENVIRONMENT_DIR="${PHP_DIR}/environment"
    fi
    POOLS_DIR="${PHP_DIR}/fpm/pools.d"
fi

if [ -z "${POOLS_DIR}" ]; then
    print_error "[php-fpm-pool] Could not detect PHP pool directory, skipping"
    liftoff
fi

MAIN_CONF="${POOLS_DIR}/www.conf"
PM_CONF="${POOLS_DIR}/www/www-pm.conf"

# Resolve effective pm values. Precedence is ALL-OR-NOTHING per group:
# if ANY PHPFPM_POOL_WWW_* pm variable is set, the whole pool-specific group
# wins and unset members fall back to upstream defaults (mixing individual
# settings from both groups can produce invalid combos, e.g. spare > max_children).
# Only when no pool-specific pm variable is set does the generic PHP_FPM_*
# group apply.
POOL_SPECIFIC_SET=""
for var in PHPFPM_POOL_WWW_PROCESS_MANAGER \
           PHPFPM_POOL_WWW_MAX_CHILDREN \
           PHPFPM_POOL_WWW_START_SERVERS \
           PHPFPM_POOL_WWW_MIN_SPARE_SERVERS \
           PHPFPM_POOL_WWW_MAX_SPARE_SERVERS \
           PHPFPM_POOL_WWW_MAX_REQUESTS; do
    [ -n "${!var}" ] && POOL_SPECIFIC_SET=1
done

PM_PROCESS_MANAGER="${PHPFPM_POOL_WWW_PROCESS_MANAGER}"
PM_MAX_CHILDREN="${PHPFPM_POOL_WWW_MAX_CHILDREN}"
PM_START_SERVERS="${PHPFPM_POOL_WWW_START_SERVERS}"
PM_MIN_SPARE="${PHPFPM_POOL_WWW_MIN_SPARE_SERVERS}"
PM_MAX_SPARE="${PHPFPM_POOL_WWW_MAX_SPARE_SERVERS}"
PM_MAX_REQUESTS="${PHPFPM_POOL_WWW_MAX_REQUESTS}"

if [ -z "${POOL_SPECIFIC_SET}" ]; then
    PM_PROCESS_MANAGER="${PM_PROCESS_MANAGER:-${PHP_FPM_PM}}"
    PM_MAX_CHILDREN="${PM_MAX_CHILDREN:-${PHP_FPM_MAX_CHILDREN}}"
    PM_START_SERVERS="${PM_START_SERVERS:-${PHP_FPM_START_SERVERS}}"
    PM_MIN_SPARE="${PM_MIN_SPARE:-${PHP_FPM_MIN_SPARE_SERVERS}}"
    PM_MAX_SPARE="${PM_MAX_SPARE:-${PHP_FPM_MAX_SPARE_SERVERS}}"
    PM_MAX_REQUESTS="${PM_MAX_REQUESTS:-${PHP_FPM_MAX_REQUESTS}}"
fi

PM_PROCESS_MANAGER="${PM_PROCESS_MANAGER:-dynamic}"
PM_MAX_CHILDREN="${PM_MAX_CHILDREN:-75}"
PM_START_SERVERS="${PM_START_SERVERS:-2}"
PM_MIN_SPARE="${PM_MIN_SPARE:-1}"
PM_MAX_SPARE="${PM_MAX_SPARE:-3}"
PM_MAX_REQUESTS="${PM_MAX_REQUESTS:-0}"

# set_pm <directive> <value> <pool_specific_varname>:
#   Update a pm directive in the upstream-generated fragment, but only when
#   the operator has NOT explicitly set the pool-specific variable (upstream
#   already honored it in that case).
set_pm() {
    local key="$1"
    local val="$2"
    local pool_var="$3"
    if [ -n "${!pool_var}" ]; then
        print_debug "[php-fpm-pool] ${pool_var} set, keeping upstream value for ${key}"
        return 0
    fi
    if grep -q "^${key}[[:space:]]*=" "${PM_CONF}"; then
        sed -i "s#^${key}[[:space:]]*=.*#${key}                              = ${val}#g" "${PM_CONF}"
    else
        echo "${key}                              = ${val}" >> "${PM_CONF}"
    fi
    print_debug "[php-fpm-pool] Set ${key} = ${val} in ${PM_CONF}"
}

if [ -f "${PM_CONF}" ]; then
    # --- Normal path: upstream generated the default pool; patch pm values ---
    if [ -n "${POOL_SPECIFIC_SET}" ]; then
        print_debug "[php-fpm-pool] PHPFPM_POOL_WWW_* pm variables set; upstream already honored them, no PHP_FPM_* patching"
    else
        set_pm "pm" "${PM_PROCESS_MANAGER}" "PHPFPM_POOL_WWW_PROCESS_MANAGER"
        set_pm "pm.max_children" "${PM_MAX_CHILDREN}" "PHPFPM_POOL_WWW_MAX_CHILDREN"
        set_pm "pm.start_servers" "${PM_START_SERVERS}" "PHPFPM_POOL_WWW_START_SERVERS"
        set_pm "pm.min_spare_servers" "${PM_MIN_SPARE}" "PHPFPM_POOL_WWW_MIN_SPARE_SERVERS"
        set_pm "pm.max_spare_servers" "${PM_MAX_SPARE}" "PHPFPM_POOL_WWW_MAX_SPARE_SERVERS"
        set_pm "pm.max_requests" "${PM_MAX_REQUESTS}" "PHPFPM_POOL_WWW_MAX_REQUESTS"
    fi
    liftoff
fi

if [ ! -f "${MAIN_CONF}" ]; then
    # --- Recovery path: the default pool was never generated ---
    print_warn "[php-fpm-pool] Default www pool missing (PHPFPM_POOL_WWW_* set without LISTEN_TYPE?); generating it"

    NGINX_USER="${NGINX_USER:-nginx}"
    NGINX_GROUP="${NGINX_GROUP:-www-data}"
    SOCKET="/var/lib/php-fpm/run/www.sock"
    LOG_PATH="${PHPFPM_POOL_DEFAULT_LOG_PATH:-/logs/php-fpm/}"
    STATUS_PATH="${PHPFPM_POOL_DEFAULT_STATUS_PATH:-/php-fpm_status}"
    PING_PATH="${PHPFPM_POOL_DEFAULT_PING_PATH:-/ping}"

    # Socket directory (php-fpm service runs as an unprivileged user)
    mkdir -p /var/lib/php-fpm/run
    chown "${PHPFPM_USER:-php}:${PHPFPM_GROUP:-php}" /var/lib/php-fpm/run 2>/dev/null || true
    chmod 0775 /var/lib/php-fpm/run 2>/dev/null || true

    # Access log directory/file (owned by the pool user so php-fpm can open it)
    mkdir -p "${LOG_PATH}"
    chown "${NGINX_USER}:${NGINX_GROUP}" "${LOG_PATH}" 2>/dev/null || true
    chmod 0775 "${LOG_PATH}" 2>/dev/null || true
    touch "${LOG_PATH%/}/www-access.log" 2>/dev/null || true
    chown "${NGINX_USER}:${NGINX_GROUP}" "${LOG_PATH%/}/www-access.log" 2>/dev/null || true
    chmod 0664 "${LOG_PATH%/}/www-access.log" 2>/dev/null || true

    # Pool environment includes (only existing ones)
    ENV_INCLUDES=""
    for envvar in PATH TEMP TMP TMPDIR; do
        if [ -f "${ENVIRONMENT_DIR}/${envvar}" ]; then
            ENV_INCLUDES="${ENV_INCLUDES}include = ${ENVIRONMENT_DIR}/${envvar}"$'\n'
        fi
    done

    mkdir -p "${POOLS_DIR}/www"
    cat > "${MAIN_CONF}" <<EOF
[www]
user = ${NGINX_USER}
group = ${NGINX_GROUP}
clear_env = no
listen = ${SOCKET}
listen.owner = ${NGINX_USER}
listen.group = ${NGINX_GROUP}
pm = ${PM_PROCESS_MANAGER}
pm.max_children = ${PM_MAX_CHILDREN}
pm.max_requests = ${PM_MAX_REQUESTS}
pm.max_spare_servers = ${PM_MAX_SPARE}
pm.min_spare_servers = ${PM_MIN_SPARE}
pm.process_idle_timeout = ${PHPFPM_POOL_WWW_PROCESS_IDLE_TIMEOUT:-10s}
pm.start_servers = ${PM_START_SERVERS}
pm.status_path = ${STATUS_PATH}
access.log = ${LOG_PATH%/}/www-access.log
php_admin_value[max_execution_time] = ${PHP_TIMEOUT:-180}
php_admin_value[max_input_nesting_level] = 256
php_admin_value[max_input_vars] = 10000
php_admin_value[memory_limit] = ${PHP_MEMORY_LIMIT:-128M}
php_admin_value[openssl.cafile] = /etc/ssl/certs/ca-certificates.crt
php_admin_value[openssl.capath] = /etc/ssl/certs
php_admin_value[output_buffering] = 0
php_admin_value[post_max_size] = ${PHP_POST_MAX_SIZE:-2G}
php_admin_value[upload_max_filesize] = ${PHP_UPLOAD_MAX_SIZE:-2G}
php_flag[display_errors] = true
catch_workers_output = true
ping.path = ${PING_PATH}
${ENV_INCLUDES}
EOF
    print_info "[php-fpm-pool] Generated default pool at ${MAIN_CONF}"

    # Nginx upstream block (normally created by the upstream pool generator)
    UPSTREAM_DIR="/etc/nginx/server.conf.d/upstream"
    mkdir -p "${UPSTREAM_DIR}"
    cat > "${UPSTREAM_DIR}/upstream-phpfpm-www.conf" <<EOF
upstream phpfpm-www-upstream {
    server unix:${SOCKET};
}
EOF
    print_info "[php-fpm-pool] Generated nginx upstream block"

    # Render the nginx php location block placeholders
    SITE_NAME="${NGINX_SITE_ENABLED:-drupal}"
    SITE_NAME="${SITE_NAME%%,*}"
    PHP_BLOCK="/etc/nginx/sites.enabled/${SITE_NAME}/location/20-php_block.conf"
    if [ -f "${PHP_BLOCK}" ] && grep -q "{{" "${PHP_BLOCK}"; then
        # {{php_upstream}} is replaced by the full fastcgi_pass directive
        # (the line already carries the trailing ';')
        sed -i 's#{{php_upstream}}#fastcgi_pass phpfpm-www-upstream#g; s#{{php_index_file}}#index.php#g' "${PHP_BLOCK}"
        print_info "[php-fpm-pool] Rendered placeholders in ${PHP_BLOCK}"
    fi
fi

liftoff
